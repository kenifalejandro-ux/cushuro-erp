NODE_ENV=development
PORT=3000

# JWT — obligatorio, el server no arranca sin esto (ver src/server/config/env.ts).
# Genera uno fuerte: openssl rand -base64 48
JWT_SECRET=
# Corto a propósito: la revocación real la hace token_version (columna en
# usuarios, ver migrations/0003_token_version.sql), no la expiración del JWT.
JWT_EXPIRES=30m
# También es la vida del refresh token (cookie "{AUTH_COOKIE_NAME}_refresh",
# tabla refresh_tokens) — cuánto puede durar una sesión renovándose sola
# antes de forzar login otra vez. Ver POST /api/auth/refresh.
SESSION_TTL_SECONDS=2592000
AUTH_COOKIE_NAME=erp_token

# "Continuar con Google" — opcional. Sin esto, el botón simplemente no se
# muestra en el login y POST /api/auth/google responde 503. Crea un OAuth
# Client ID de tipo "Web application" en Google Cloud Console y agrega el
# origen (http://localhost:5174 en dev) a "Authorized JavaScript origins".
GOOGLE_LOGIN_CLIENT_ID=

# Base del link en el correo de recuperación de contraseña, cuando el
# tenant no tiene dominio propio ni subdominio de plataforma configurado.
APP_PUBLIC_URL=http://localhost:5174

# PostgreSQL — el usuario debe ser owner de las tablas de la app (no postgres),
# para poder correr ALTER TABLE en migraciones futuras sin sudo.
# Obligatorias solo si NO defines DATABASE_URL (ver env.ts: pgVarsRequeridas).
PG_HOST=localhost
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=

# Railway u otro proveedor gestionado inyecta esta variable en vez de las
# PG_* individuales — database.ts la detecta automáticamente y, si está
# presente, las PG_* dejan de ser obligatorias.
# DATABASE_URL=

# Redis (sesiones + rate limiting + cache). Sin esto, ambos caen a un
# fallback en memoria — funcional en local, no recomendable en producción
# con más de una instancia del server.
# REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS — orígenes permitidos en producción, separados por coma
# (en desarrollo se permite cualquier origen automáticamente)
ALLOWED_ORIGINS=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5

# Email (alertas / notificaciones del ERP)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=

# reCAPTCHA — protege /api/auth/login en producción
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Onboarding de tenants (POST /api/platform/tenants) — separado del login
# normal a propósito, es una operación tuya como dueño del ERP, no de un
# usuario de un tenant. Sin esto configurado, el endpoint responde 503.
# Genera uno fuerte: openssl rand -base64 48
PLATFORM_ADMIN_TOKEN=

# Cuánto dura la sesión de login por cookie del panel (platformSession.service.ts)
PLATFORM_SESSION_TTL_MS=43200000

# Rate limits específicos del panel de plataforma — separados del genérico
# de arriba porque comparten Redis con TODO lo demás (incluidos tests si
# corren contra el mismo Redis): si tu suite crea muchos tenants/logins de
# admin seguidos, subí estos dos en tu .env local (nunca en producción).
PLATFORM_TENANT_CREATION_WINDOW_MS=900000
PLATFORM_TENANT_CREATION_MAX_REQUESTS=5
PLATFORM_ADMIN_LOGIN_WINDOW_MS=900000
PLATFORM_ADMIN_LOGIN_MAX_REQUESTS=10

# Dónde vive el contenido de los backups de tenant (platformBackup.service.ts)
# — filesystem local por default. Contiene datos reales de clientes
# (incluidos password_hash): protegé este directorio igual que la base de
# datos, nunca lo sirvas por una ruta estática.
BACKUPS_DIR=./backups

# Cifrado reversible de secretos de plataforma (hoy: el client_secret OIDC
# de cada tenant con SSO configurado, ver platformCrypto.ts). Sin esto,
# guardar o usar un SSO de tenant responde 503 — no bloquea el arranque del
# server porque no todos los despliegues necesitan SSO. Separado a
# propósito de JWT_SECRET (cifrar vs firmar son cosas distintas).
# Genera uno: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# SSO de Platform Admin — un solo proveedor OIDC global (a diferencia del
# SSO por tenant, que se configura por empresa desde el panel). Opcional:
# sin esto, el botón de SSO simplemente no aparece en /plataforma.
PLATFORM_SSO_ISSUER_URL=
PLATFORM_SSO_CLIENT_ID=
PLATFORM_SSO_CLIENT_SECRET=
