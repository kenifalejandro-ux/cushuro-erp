NODE_ENV=development
PORT=3000

# JWT — obligatorio, el server no arranca sin esto (ver src/server/config/env.ts).
# Genera uno fuerte: openssl rand -base64 48
JWT_SECRET=
# Corto a propósito: la revocación real la hace token_version (columna en
# usuarios, ver migrations/0002_token_version.sql), no la expiración del JWT.
JWT_EXPIRES=30m
# También es la vida del refresh token (cookie "{AUTH_COOKIE_NAME}_refresh",
# tabla refresh_tokens) — cuánto puede durar una sesión renovándose sola
# antes de forzar login otra vez. Ver POST /api/auth/refresh.
SESSION_TTL_SECONDS=2592000
AUTH_COOKIE_NAME=erp_token

# PostgreSQL — el usuario debe ser owner de las tablas de la app (no postgres),
# para poder correr ALTER TABLE en migraciones futuras sin sudo.
# Obligatorias solo si NO defines DATABASE_URL (ver env.ts: pgVarsRequeridas).
PG_HOST=localhost
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=

# Railway u otro proveedor gestionado inyecta esta variable en vez de las
# PG_* individuales — database.ts la detecta automáticamente y, si está
# presente, las PG_* dejan de ser obligatorias.
# DATABASE_URL=

# Redis (sesiones + rate limiting + cache). Sin esto, ambos caen a un
# fallback en memoria — funcional en local, no recomendable en producción
# con más de una instancia del server.
# REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS — orígenes permitidos en producción, separados por coma
# (en desarrollo se permite cualquier origen automáticamente)
ALLOWED_ORIGINS=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5

# Email (alertas / notificaciones del ERP)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=

# reCAPTCHA — protege /api/auth/login en producción
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
