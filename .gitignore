/node_modules
/brochure
.env
.env.*
!.env.example
client/.env
client/.env.*
!client/.env.example

# Datos operativos reales / documentos comerciales, no código
/combustible
/propuesta_cushuro_erp.html

# Backups de tenant (platformBackup.service.ts) — contienen datos reales
# de clientes (incluidos password_hash), nunca van al repo.
/backups

# Archivos subidos al módulo Documentos con driver "local" (dev/tests) —
# contenido real de clientes, nunca va al repo.
/documentos_archivos

# Estado interno de Vitest (qué test falló la última corrida) y de
# Playwright (traces/screenshots de fallos) — cambia en cada run, no aporta
# nada versionado.
/test-results
/playwright-report

# Reporte de coverage (vitest run --coverage) — se regenera en cada corrida.
/coverage
