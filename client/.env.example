EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=alerts@example.com
EMAIL_PASS=replace-with-app-password
CONTACT_EMAIL_TO=contacto@empresa.com

RECAPTCHA_SITE_KEY=replace-with-recaptcha-site-key
RECAPTCHA_SECRET_KEY=replace-with-recaptcha-secret-key
RECAPTCHA_EXPECTED_ACTION=submit
RECAPTCHA_MIN_SCORE=0.5

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tu-dominio.com
VITE_SITE_URL=https://tu-dominio.com

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5

REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

BODY_LIMIT=16kb
EMAIL_MAX_CONNECTIONS=5
EMAIL_MAX_MESSAGES=100
LOG_LEVEL=debug

VITE_IMG_URL=https://tu-dominio.com

# "Continuar con Google" — opcional, ver GOOGLE_LOGIN_CLIENT_ID en el .env raíz.
VITE_GOOGLE_LOGIN_CLIENT_ID=

# Igual que APP_APEX_DOMAIN en el .env raíz — mientras esté vacío, el login
# siempre muestra el campo "Empresa". Configurado, lo oculta cuando la app
# corre en "<slug>.<dominio>" (ver LoginPage.tsx).
VITE_APP_APEX_DOMAIN=

# Slug de tenant a usar cuando NO se detecta subdominio de cliente (ej. en
# localhost o en el dominio raíz) — oculta el campo "Empresa" y usa este
# valor directamente. Pensado para el propio entorno del dueño de la
# plataforma, que hoy solo administra un tenant. Déjalo vacío si en algún
# momento necesitas volver a elegir tenant a mano.
VITE_DEFAULT_TENANT_SLUG=

# ── Sentry (frontend) ─────────────────────────────────────────────────────
# Vacío = Sentry NO se inicializa y todo queda no-op, igual que SENTRY_DSN
# en el .env raíz para el backend. Es un proyecto de Sentry APARTE del
# backend: son dos plataformas distintas (browser vs node) y conviene poder
# mirarlas por separado.
#
# OJO: al configurarlo hay que sumar el dominio del DSN a `connect-src` en
# la policy de CSP (src/server/app.ts) o el navegador bloquea los reportes
# SIN avisar — no hay error visible, los eventos simplemente no llegan.
VITE_SENTRY_DSN=

# Default: el MODE de Vite ("production" en el build, "development" en dev).
# Sirve para separar entornos en Sentry si algún día hay staging.
VITE_SENTRY_ENVIRONMENT=
